{
  "name": "afterglow",
  "version": "1.0.0",
  "description": "Your GitHub year as a spinning ASCII shape, with your posts and links, as one terminal dashboard for a profile README.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": "github:raelsei/afterglow",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "start": "bun src/main.ts",
    "preview": "bun src/preview.ts",
    "build": "bun build src/main.ts --target=node --format=esm --minify --outfile dist/index.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/opentype.js": "^1.3.10",
    "typescript": "^7.0.2"
  }
}
